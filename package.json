    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "@types/html2canvas": "^0.5.35",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"

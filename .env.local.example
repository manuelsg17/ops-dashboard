# Copiar a `.env.local` para que `npm run dev` apunte al Supabase LOCAL.
# Sin `.env.local`, la app usa produccion (ver src/core/config.ts) — que es lo
# que hacen los builds de Vercel y GitHub Pages.
#
# El anon key lo imprime `npx supabase start`; tambien sale con
# `npx supabase status`. Es una clave de firma local de juguete, no un secreto.

VITE_SUPABASE_URL=http://127.0.0.1:54331
VITE_SUPABASE_ANON_KEY=pegar-el-anon-key-que-imprime-supabase-start
